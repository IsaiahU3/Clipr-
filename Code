function BottomNav({ tab, setTab }) {
  const items = [
    { id: "home", label: "Home", icon: HomeIcon },
    { id: "projects", label: "Projects", icon: FolderOpen },
    { id: "create", label: "Create", icon: PlusCircle },
    { id: "analytics", label: "Analytics", icon: BarChart3 },
    { id: "profile", label: "Profile", icon: User },
  ];
  return (
    <div
      style={{
        display: "flex",
        borderTop: `1px solid ${C.border}`,
        background: "rgba(10,10,12,0.92)",
        backdropFilter: "blur(10px)",
        padding: "10px 6px calc(env(safe-area-inset-bottom, 0px) + 10px)",
      }}
    >
      {items.map((it) => {
        const Icon = it.icon;
        const active = tab === it.id;
        const isCreate = it.id === "create";
        return (
          <button
            key={it.id}
            onClick={() => setTab(it.id)}
            style={{
              flex: 1,
              display: "flex",
              flexDirection: "column",
              alignItems: "center",
              gap: 4,
              background: "none",
              border: "none",
              cursor: "pointer",
              padding: "4px 0",
            }}
          >
            {isCreate ? (
              <div
                style={{
                  width: 30,
                  height: 30,
                  borderRadius: 9,
                  background: active ? C.accent : C.surface2,
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  marginBottom: -2,
                }}
              >
                <Icon size={16} color={active ? "#fff" : C.textDim} />
              </div>
            ) : (
              <Icon size={19} color={active ? C.accent2 : C.textFaint} strokeWidth={active ? 2.4 : 2} />
            )}
            <span
              style={{
                fontSize: 10,
                fontWeight: active ? 700 : 500,
                color: active ? C.text : C.textFaint,
              }}
            >
              {it.label}
            </span>
          </button>
        );
      })}
    </div>
  );
}

/* ---------------------------------------------------------------
   ROOT APP
--------------------------------------------------------------- */
export default function App() {
  const [tab, setTab] = useState("home");
  // flow: idle -> generating -> results -> editor
  const [flow, setFlow] = useState("idle");
  const [activeClip, setActiveClip] = useState(null);

  const handleGenerate = () => {
    setFlow("generating");
    setTimeout(() => setFlow("results"), 2600);
  };

  const resetFlow = () => {
    setFlow("idle");
    setActiveClip(null);
    setTab("home");
  };

  let screen;
  if (tab === "create") {
    if (flow === "generating") screen = <GeneratingScreen />;
    else if (flow === "results")
      screen = (
        <ResultsScreen
          onBack={() => setFlow("idle")}
          onEdit={(c) => {
            setActiveClip(c);
            setFlow("editor");
          }}
        />
      );
    else if (flow === "editor")
      screen = <EditorScreen clip={activeClip} onBack={() => setFlow("results")} />;
    else screen = <CreateScreen onGenerate={handleGenerate} />;
  } else if (tab === "home") {
    screen = <HomeScreen goCreate={() => setTab("create")} goProjects={() => setTab("projects")} />;
  } else if (tab === "projects") {
    screen = <ProjectsScreen />;
  } else if (tab === "analytics") {
    screen = <AnalyticsScreen />;
  } else if (tab === "profile") {
    screen = <ProfileScreen />;
  }

  return (
    <div
      style={{
        width: "100%",
        minHeight: "100vh",
        background: "#050506",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        fontFamily: fontStack,
        padding: 24,
      }}
    >
      {/* phone frame */}
      <div
        style={{
          width: 390,
          height: 820,
          borderRadius: 44,
          background: C.bg,
          border: "10px solid #000",
          boxShadow: "0 40px 80px -20px rgba(0,0,0,0.7), 0 0 0 1px #1a1a1a",
          overflow: "hidden",
          display: "flex",
          flexDirection: "column",
          position: "relative",
        }}
      >
        {/* status bar */}
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            padding: "16px 26px 6px",
            fontSize: 13,
            fontWeight: 700,
            color: C.text,
            flexShrink: 0,
          }}
        >
          <span>9:41</span>
          <div
            style={{
              position: "absolute",
              top: 8,
              left: "50%",
              transform: "translateX(-50%)",
              width: 90,
              height: 24,
              background: "#000",
              borderRadius: 14,
            }}
          />
          <div style={{ display: "flex", gap: 4, alignItems: "center" }}>
            <span style={{ fontSize: 11 }}>5G</span>
            <div style={{ width: 20, height: 10, border: `1px solid ${C.text}`, borderRadius: 2 }} />
          </div>
        </div>

        {/* brand row */}
        <div
          style={{
            display: "flex",
            alignItems: "center",
            gap: 8,
            padding: "4px 20px 10px",
            flexShrink: 0,
          }}
        >
          <div
            style={{
              width: 22,
              height: 22,
              borderRadius: 6,
              background: C.accent,
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
            }}
          >
            <Video size={12} color="#fff" strokeWidth={2.6} />
          </div>
          <span style={{ color: C.text, fontWeight: 800, fontSize: 13, letterSpacing: 1.5 }}>
            VYRAL
          </span>
        </div>

        {/* content */}
        <div style={{ flex: 1, overflowY: "auto" }}>{screen}</div>

        {/* bottom nav — hidden during generating/editor sub-flows for focus */}
        {!(tab === "create" && (flow === "generating" || flow === "editor")) && (
          <BottomNav tab={tab} setTab={(t) => { setTab(t); if (t !== "create") setFlow("idle"); }} />
        )}
      </div>
    </div>
  );
}
